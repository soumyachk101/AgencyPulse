# ──────────────────────────────────────────────────────────────
# AgencyPulse · Environment Variables
# Copy to .env.local (Next.js) or .env (scripts) and fill in.
# ──────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────
NODE_ENV=production
PORT=3003
HOSTNAME=0.0.0.0
NEXT_PUBLIC_APP_URL=http://localhost:3003
NEXT_PUBLIC_API_URL=http://localhost:3003

# ── Database (Postgres) ─────────────────────────────────────
DATABASE_URL=postgresql://agencypulse:change_me@localhost:5432/agencypulse?schema=public
DIRECT_URL=postgresql://agencypulse:change_me@localhost:5432/agencypulse?schema=public

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://:change_me@localhost:6379

# ── Authentication ──────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3003
NEXTAUTH_SECRET=replace_me_with_64_char_base64

# OAuth providers (at least one required)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Security ────────────────────────────────────────────────
CSRF_SECRET=replace_me_with_32_char_base64
JWT_SECRET=replace_me_with_64_char_base64
ENCRYPTION_KEY=replace_me_with_32_char_base64 # AES-256

# ── Integrations ────────────────────────────────────────────
GOOGLE_ANALYTICS_API_KEY=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

HUBSPOT_API_KEY=
HUBSPOT_PORTAL_ID=

SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

SENDGRID_API_KEY=
EMAIL_FROM=noreply@agencypulse.app

# ── AI / Summaries ──────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ── Storage ─────────────────────────────────────────────────
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT= # Leave blank for AWS S3; set for MinIO / R2

# ── Cron / Scheduler ────────────────────────────────────────
CRON_SECRET=replace_me_with_random_string

# ── Feature Flags ───────────────────────────────────────────
NEXT_PUBLIC_ENABLE_AI_SUMMARIES=true
NEXT_PUBLIC_ENABLE_WHITE_LABEL=true
NEXT_PUBLIC_ENABLE_DARK_MODE=true
